enum ResearchSourceStatus:
    "cited"
    "consulted"
    "rejected"

enum VerificationStatus:
    "accepted"
    "follow_up"
    "failed"

enum VerificationSeverity:
    "warning"
    "error"

enum VerificationResolution:
    "none"
    "repair"
    "research"
    "fatal"

type ResearchSource:
    title: string(min_length=1)
    url: string(min_length=1)
    publisher: string?
    published_at: string?
    revision: string?
    accessed_at: string?
    summary: string?
    credibility_notes: string?
    status: ResearchSourceStatus

type ResearchSection:
    id: string(min_length=1)
    title: string(min_length=1)
    focus: string(min_length=1)
    guiding_questions: list[string](min_items=1)

type ResearchPlan:
    title: string(min_length=1)
    primary_objective: string(min_length=1)
    audience: string(min_length=1)
    key_sections: list[ResearchSection](min_items=3,max_items=5)
    research_questions: list[string](min_items=1)
    methodology_preferences: list[string]
    topic_flags: list[string]

type ResearchAgenda:
    sections: list[ResearchSection](min_items=3,max_items=5)
    source_strategy: list[string](min_items=1)
    verification_focus: list[string](min_items=1)

type SectionFinding:
    title: string(min_length=1)
    evidence: string(min_length=1)
    implications: string?
    source_urls: list[string](min_items=1)

type SectionResearchBrief:
    section_id: string(min_length=1)
    title: string(min_length=1)
    summary: string(min_length=1)
    key_terms: list[string]
    guiding_questions: list[string]
    findings: list[SectionFinding]
    sources: list[ResearchSource]
    open_questions: list[string]

type SourceLedgerEntry:
    id: string(min_length=1)
    title: string(min_length=1)
    url: string(min_length=1)
    publisher: string?
    published_at: string?
    revision: string?
    accessed_at: string?
    summary: string?
    credibility_notes: string?
    status: ResearchSourceStatus
    section_ids: list[string]

type SourceLedger:
    entries: list[SourceLedgerEntry]

type VerificationIssue:
    section_id: string?
    code: string(min_length=1)
    message: string(min_length=1)
    severity: VerificationSeverity
    resolution: VerificationResolution
    required_change: string(min_length=1)

type VerificationReport:
    status: VerificationStatus
    issues: list[VerificationIssue]
    notes: string?

type SectionContentRevision:
    section_id: string(min_length=1)
    summary: string(min_length=1)
    findings: list[SectionFinding]
    open_questions: list[string]

type EvidenceRepairResult:
    revisions: list[SectionContentRevision](min_items=1)

type TargetedSectionRevision:
    section_id: string(min_length=1)
    summary: string(min_length=1)
    findings: list[SectionFinding]
    sources: list[ResearchSource]
    open_questions: list[string]

type TargetedResearchResult:
    revisions: list[TargetedSectionRevision](min_items=1)

type SectionIssueSet:
    brief: SectionResearchBrief
    issues: list[VerificationIssue](min_items=1)

type InsightPayload:
    title: string(min_length=1)
    evidence: string(min_length=1)
    implications: string?
    citations: list[string](min_items=1)

type SectionPayload:
    id: string(min_length=1)
    title: string(min_length=1)
    summary: string(min_length=1)
    key_terms: list[string]
    guiding_questions: list[string]
    insights: list[InsightPayload]

type CitationPayload:
    id: string(min_length=1)
    title: string(min_length=1)
    url: string(min_length=1)
    publisher: string?
    published_at: string?
    revision: string?
    accessed_at: string?
    summary: string?

type CompendiumPayload:
    topic_overview: string(min_length=1)
    methodology: list[string]
    sections: list[SectionPayload](min_items=1,max_items=5)
    citations: list[CitationPayload]
    open_questions: list[string]

type WebSearchRequest:
    query: string(min_length=1)

type WebSearchResult:
    summary: string(min_length=1)
    source_urls: list[string]

type PlanningInput:
    topic: string(min_length=1)

type ResearchAgendaInput:
    topic: string(min_length=1)
    plan: ResearchPlan

type SectionResearchInput:
    topic: string(min_length=1)
    section: ResearchSection
    plan: ResearchPlan
    agenda: ResearchAgenda

type EvidenceRepairInput:
    topic: string(min_length=1)
    plan: ResearchPlan
    agenda: ResearchAgenda
    sections: list[SectionIssueSet](min_items=1)

type TargetedResearchInput:
    topic: string(min_length=1)
    plan: ResearchPlan
    agenda: ResearchAgenda
    sections: list[SectionIssueSet](min_items=1)

type VerificationInput:
    topic: string(min_length=1)
    plan: ResearchPlan
    agenda: ResearchAgenda
    section_briefs: list[SectionResearchBrief]
    source_ledger: SourceLedger

type SynthesisInput:
    topic: string(min_length=1)
    plan: ResearchPlan
    agenda: ResearchAgenda
    section_briefs: list[SectionResearchBrief]
    source_ledger: SourceLedger
    verification: VerificationReport
